# Copy this file to .env and fill in real values. Never commit .env.

# Public base URL used in links inside emails (landlord response, photo upload)
BASE_URL=http://localhost:8000

# Demo property (one property for the hackathon)
PROPERTY_ADDRESS=12 Example St, Apt 3, Boston MA
TENANT_NAME=Alex Tenant
TENANT_EMAIL=tenant@example.com
LANDLORD_NAME=Sam Landlord
LANDLORD_EMAIL=landlord@example.com

# Simple passcode protecting tenant web pages (demo-level security)
TENANT_PASSCODE=change-me

# Storage backends: "console"/"local" for dev, "ses"/"s3" for production
MAILER=console
PHOTO_STORE=local
DATABASE_PATH=fixtrail.db

# Photo replies by email (Section 7b).
# Tenant emails get Reply-To: photos+<issue_token>@INBOUND_EMAIL_DOMAIN
# Locally, replies are simulated with .eml files in inbox/.
INBOUND_EMAIL_DOMAIN=fixtrail.example.com
MAX_PHOTO_MB=10

# AWS (only needed in production, Phase 7)
AWS_REGION=us-east-1
SES_FROM_EMAIL=
S3_BUCKET=

# Alexa+ simulator (/simulator)
# "offline" = keyword rules, no AI, no AWS needed.
# "bedrock" = a real AI model on Amazon Bedrock via the Strands Agents SDK
#             (needs AWS credentials and costs a little per request).
SIMULATOR_MODE=offline
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Where the simulator reaches FixTrail's MCP server (defaults to BASE_URL + /mcp)
# SIMULATOR_MCP_URL=http://localhost:8000/mcp

# Extra public addresses the MCP endpoint should accept, comma-separated
# (BASE_URL's host is always allowed). Example: a temporary Cloudflare tunnel.
# ALLOWED_HOSTS=your-tunnel.trycloudflare.com

# Production photo replies (Phase 7): SES receipt rule -> S3 bucket + SNS topic
# -> POST https://your-domain/inbound/ses?secret=INBOUND_SECRET
INBOUND_SECRET=
INBOUND_SNS_TOPIC_ARN=
INBOUND_S3_BUCKET=
